board = [" "] * 9

def show():
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])

def win(p):
    for a, b, c in [(0,1,2),(3,4,5),(6,7,8),
                    (0,3,6),(1,4,7),(2,5,8),
                    (0,4,8),(2,4,6)]:
        if board[a] == board[b] == board[c] == p:
            return True

player = "X"

for i in range(9):
    show()
    pos = int(input(player + " position (1-9): ")) - 1

    if board[pos] == " ":
        board[pos] = player
    else:
        print("Already occupied!")
        continue

    if win(player):
        show()
        print(player, "wins!")
        break

    player = "O" if player == "X" else "X"
else:
    show()
    print("Draw!")
